#!/bin/zsh
# Super simple fleet dashboard launcher for your Roku TV
# Usage: ./fleet   or just "fleet" if you add to PATH

IP="10.0.0.73"
DASH_DIR="$HOME/roku-experiments/fleet-dashboard-web"
CTL="$HOME/roku-experiments/roku_ctl.py"

echo "🚀 Starting Fleet Dashboard mode for Roku at $IP..."

# 1. Make sure the control script is ready
if [ ! -f "$CTL" ]; then
    echo "Error: Control script not found at $CTL"
    exit 1
fi

# 2. Start the web dashboard server in background (if not already)
DASH_PORT=8080
if ! curl -s http://localhost:$DASH_PORT > /dev/null 2>&1; then
    echo "Starting dashboard web server on port $DASH_PORT..."
    cd "$DASH_DIR" || exit 1
    python3 -m http.server $DASH_PORT > /tmp/fleet-dash.log 2>&1 &
    DASH_PID=$!
    echo "Dashboard running at http://localhost:$DASH_PORT (PID: $DASH_PID)"
    sleep 1.5
else
    echo "Dashboard already serving at http://localhost:$DASH_PORT"
fi

# 3. Prepare the TV (Home, volume, ready for cast)
echo "Preparing the TV..."
python3 "$CTL" --ip "$IP" fleet --cast

echo ""
echo "✅ Done! TV is ready."
echo ""
echo "NEXT STEP (super simple):"
echo "1. On your Mac: Open Control Center (top-right) → Screen Mirroring → select your Hisense Roku TV"
echo "2. In browser go to http://localhost:$DASH_PORT"
echo "3. Mirror the tab or full screen to the TV"
echo ""
echo "Bonus TV controls (from terminal):"
echo "  python3 $CTL --ip $IP press Play"
echo "  python3 $CTL --ip $IP launch Plex"
echo "  python3 $CTL --ip $IP status"
echo ""
echo "To stop the dashboard server later: pkill -f 'http.server $DASH_PORT'"
echo "Have fun with the cool stuff! 🎉"